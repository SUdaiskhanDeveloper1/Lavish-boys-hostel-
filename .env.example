# Copy this file to `.env` and fill in real values, then restart `npm run dev`.
# Never commit `.env` or put real keys / passwords in this example file.

# ── Supabase ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
#
# VITE_SUPABASE_URL must be the *API* URL shown as "Project URL":
#   correct   https://<project-ref>.supabase.co
#   WRONG     https://supabase.com/dashboard/project/<project-ref>   ← dashboard URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── App ──────────────────────────────────────────────────
VITE_APP_NAME=Lavish Boys Hostel
VITE_DEFAULT_CURRENCY=PKR
VITE_DEFAULT_DATE_FORMAT=DD/MM/YYYY

# ── Google Drive backup (optional) ───────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_DRIVE_FOLDER_ID=
